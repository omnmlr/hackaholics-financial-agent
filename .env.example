# Default is persistent embedded PostgreSQL, single Node process only.
DATABASE_URL=pglite://.data/agent
# Production: postgresql://user:password@host:5432/agent?sslmode=verify-full
APP_ORIGIN=http://localhost:3000
OPERATOR_ID=demo-operator
# Generate using npm run operator:password (password read from stdin).
OPERATOR_PASSWORD_HASH=
# fixture | test | live. Fixtures NEVER call Paystack.
PAYMENT_MODE=fixture
# Optional strict profile: fixture | sandbox | devnet | live. New foundation
# runners set this explicitly. Legacy deployments may omit it during migration.
# AGUS_ENVIRONMENT=fixture
# Devnet profile requires PAYMENT_MODE=fixture, no financial provider credential,
# and AGUS_SOLANA_DEVNET_ENABLED=true. Its bank records remain simulated.
AGUS_SOLANA_DEVNET_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_INTEGRATION_ID=
PAYSTACK_TRANSFERS_ENABLED=false
LIVE_OWNER_AUTHORIZED=false
LIVE_WEBHOOK_VALIDATED=false
LIVE_RECONCILIATION_VALIDATED=false
LIVE_TRANSFERS_ENABLED=false
PAYMENTS_EMERGENCY_DISABLED=false
# Strict live allowlist bank_code:account_number, separated by commas.
LIVE_BENEFICIARY_ALLOWLIST=
MAX_PAYMENT_KOBO=100000
MAX_BATCH_KOBO=500000
# Conservative estimate, NOT a confirmed provider fee. Override after checking pricing.
FEE_RESERVE_KOBO=5000
APP_TIMEZONE=Africa/Lagos
AI_PROVIDER=none
# none | openai | gemini
AI_API_KEY=
AI_MODEL=
# Opt-in fictional, read-only financial API. Requires PAYMENT_MODE=fixture.
# The existing authenticated operator maps server-side to fictional Amina.
FINANCIAL_DEMO_ENABLED=false
# Shared identity/platform (separate from the legacy operator login).
# PostgreSQL migrations require an explicitly supplied schema-owner connection;
# DATABASE_URL must use a least-privilege runtime role after role grants.
MIGRATION_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Supply at least 32 random characters from your secret manager.
BETTER_AUTH_SECRET=
# JSON map of version => base64-encoded 32-byte wrapping key. No default key.
# Retain old versions while encrypted data still references them.
AGUS_ENCRYPTION_KEYS=
AGUS_ENCRYPTION_ACTIVE_KEY=
# Optional fixture event authentication; never reuse a live provider credential.
FIXTURE_WEBHOOK_SECRET=
# Public authority addresses only. No private keys. Instruction templates remain
# gated; configuring addresses does not enable deployment or financial signing.
AGUS_DEVNET_ESCROW_VERIFIER=
AGUS_DEVNET_ESCROW_ARBITRATORS=

# AGUS 2.0 web: single-operator authenticated prototype, no mainnet payments.
AGUS_WORKSPACE_ENABLED=true
AGUS_AGENT_ARCHITECTURE=native-gemini
# Publishable Pollar TESTNET application key only. Never enter an sk_ secret here.
NEXT_PUBLIC_POLLAR_API_KEY=
# Exact USDC issuer enabled in your Pollar Stellar testnet application.
POLLAR_TESTNET_USDC_ISSUER=
# Optional local/private authorized Zcash receiving wallet. Never paste keys here.
# The wallet manages its own viewing/spending keys; AGUS uses read-only RPC calls.
ZCASH_WALLET_RPC_URL=
ZCASH_WALLET_RPC_USER=
ZCASH_WALLET_RPC_PASSWORD=
ZCASH_TESTNET_RECEIVING_ADDRESS=

# AGUS Crypto authentication (server only)
# Public registration requires HTTPS, Resend credentials and a verified sender.
AGUS_AUTH_PUBLIC=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AGUS_AUTH_EMAIL_FROM=

# Optional pinned-network JSON-RPC overrides (server only, HTTPS)
AGUS_DEVNET_RPC=
AGUS_MAINNET_RPC=
AGUS_DEVNET_VERIFY_RPC=
AGUS_MAINNET_VERIFY_RPC=
AGUS_CRYPTO_AI_DAILY=30
AGUS_CRYPTO_AI_GLOBAL_DAILY=500
# Gemini visual turns require local English Tesseract screening (included in the Crypto image).
AGUS_CRYPTO_IMAGES=false
# Optional public research. Keep credentials on the backend.
FIRECRAWL_API_KEY=
AGUS_CRYPTO_RESEARCH_DAILY=3
AGUS_CRYPTO_RESEARCH_GLOBAL_DAILY=10
# Optional voice transport for the authenticated Crypto assistant (server only).
AGUS_CRYPTO_VOICE_ENABLED=false
ELEVENLABS_API_KEY=
# Provisional premade voice, Jessica. Override after the founder chooses a voice.
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# Enable only on a plan with ElevenLabs zero retention support.
ELEVENLABS_ZERO_RETENTION=false
AGUS_CRYPTO_MONITORING=false
# Leave empty until each Devnet wallet route passes its signed-device gate.
AGUS_CRYPTO_DEVNET_ROUTES=
AGUS_CRYPTO_REQUIRE_STEP_UP=false
# Optional Devnet tooling. Enable after finalized request acceptance.
AGUS_CRYPTO_REQUESTS=false
AGUS_CRYPTO_INVOICES=false
