# ==============================================================================
# AGUS Crypto Production Environment Template (AWS EC2 Devnet Deployment)
# File: /etc/agus/crypto.env (Mode 0600, Owned by root:root)
# NOTE: Replace placeholder values before starting containers.
# ZERO REAL SECRETS MUST BE COMMITTED TO REPOSITORY.
# ==============================================================================

# Node Runtime Configuration
NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# Profile & Feature Flags (Fail-Closed Devnet Enforcement)
AGUS_ENVIRONMENT=devnet
AGUS_SOLANA_DEVNET_ENABLED=true
AGUS_AUTH_PUBLIC=false
PAYMENT_MODE=fixture

# Canonical Origin & Authentication URL
# MUST be HTTPS, valid URL, no trailing slash, and match BETTER_AUTH_URL exactly
APP_DOMAIN=crypto-devnet.example.com
APP_ORIGIN=https://crypto-devnet.example.com
BETTER_AUTH_URL=https://crypto-devnet.example.com

# Authentication Secret (Minimum 32 characters entropy)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET_ABC1234567890

# Database Connection (Neon PostgreSQL Restricted Runtime Role)
# IMPORTANT: Use the restricted user 'agus_crypto_devnet_runtime' with role 'agus_runtime'.
# NEVER supply database owner/superuser credentials or MIGRATION_DATABASE_URL in runtime container.
DATABASE_URL=postgresql://agus_crypto_devnet_runtime:REPLACE_WITH_PASSWORD@ep-sample-123456.us-east-1.aws.neon.tech/agus_crypto_devnet_20261124?sslmode=require

# Application Secrets Encryption (Envelope Encryption)
# Active key version must be present in AGUS_ENCRYPTION_KEYS JSON map.
# Key value must be exactly 32 raw bytes, base64-encoded.
# Generate with: openssl rand -base64 32
AGUS_ENCRYPTION_ACTIVE_KEY=v1
AGUS_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_ENCRYPTION_KEY_ABC=="}

# Crypto Monitoring & Approved Wallet Routes
AGUS_CRYPTO_MONITORING=true
AGUS_CRYPTO_DEVNET_ROUTES=phantom,solflare

# Solana Devnet RPC Endpoints
# Primary and verifier must be HTTPS and have distinct hostnames (INDEPENDENT_VERIFIER_REQUIRED)
AGUS_DEVNET_RPC=https://api.devnet.solana.com
AGUS_DEVNET_VERIFY_RPC=https://rpc.ankr.com/solana_devnet

# Optional Google OAuth Credentials (leave blank if invite-only email auth used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional AI Assistance Credentials (leave none for deterministic devnet testing)
AI_PROVIDER=none
AI_API_KEY=

# ==============================================================================
# SECURITY REMINDER / FORBIDDEN VARIABLES:
# The following variables MUST NOT exist in this environment:
# - MIGRATION_DATABASE_URL (prohibited in runtime containers; migrations run off-host)
# - PAYSTACK_SECRET_KEY    (prohibited credential contamination on devnet)
# - LIVE_TRANSFERS_ENABLED (forbidden; live financial operations disabled)
# ==============================================================================
