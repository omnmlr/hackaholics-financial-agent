{
	admin off
}

{$AGUS_CRYPTO_HOST} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	@api path /api/v1/health /api/v1/ready /api/v1/openapi /api/v1/crypto /api/v1/crypto/* /api/auth /api/auth/*
	handle @api {
		request_body {
			max_size 16MB
		}
		reverse_proxy api:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 100s
			}
		}
	}

	handle /favicon.png {
		root * /srv/agus
		file_server
	}

	handle {
		respond 404
	}
}
