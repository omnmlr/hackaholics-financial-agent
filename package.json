{
  "name": "hackaholics-financial-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preview:web": "node scripts/agus-web-preview.mjs",
    "test:web": "vitest run tests/web-product.test.ts tests/pollar-sdk.test.ts tests/conversational-payments.test.ts",
    "test:browser:web": "node scripts/browser-agus-web.mjs",
    "config:validate": "node --import=tsx scripts/validate-environment.ts",
    "solana:acceptance": "node --import=tsx scripts/verify-devnet-transfer.ts",
    "preview:devnet": "node scripts/devnet-acceptance-preview.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local --import=tsx scripts/migrate.ts",
    "operator:password": "tsx scripts/password.ts",
    "payments:reconcile": "tsx --env-file-if-exists=.env.local scripts/reconcile.ts",
    "format": "prettier --write .",
    "test:http": "node scripts/http-smoke.mjs",
    "test:browser": "node scripts/browser-chat-payments.mjs && node scripts/browser-voice-submit.mjs && node scripts/browser-voice-meter.mjs",
    "test:browser:voice": "node scripts/browser-voice-meter.mjs",
    "evaluate:agent": "node --env-file-if-exists=.env.local --import=tsx scripts/evaluate-agent.ts",
    "test:browser:workspace": "node scripts/browser-workspace.mjs",
    "test:browser:approved-p0": "node scripts/browser-approved-p0.mjs",
    "verify:narration": "tsx scripts/verify-grounded-narration.ts",
    "test:integration": "vitest run tests/financial-integration tests/financial-agent/grounded-narration.test.ts tests/financial-agent/routing.test.ts tests/financial-agent/education.test.ts tests/financial-agent/date-window.test.ts tests/payments.test.ts tests/financial-safety.test.ts tests/voice.test.ts",
    "test:browser:integration": "node scripts/browser-integration.mjs",
    "test:browser:chat-payments": "node scripts/browser-chat-payments.mjs",
    "test:browser:legacy": "node scripts/browser-safety.mjs && node scripts/browser-chat-first.mjs && node scripts/browser-chat-ux.mjs && node scripts/browser-conversation.mjs && node scripts/browser-demo-polish.mjs",
    "preview:fixture": "node scripts/preview-fixture.mjs",
    "test:browser:native": "node scripts/browser-native-agent.mjs",
    "test:browser:premium": "node scripts/browser-premium.mjs",
    "test:browser:motion": "node scripts/browser-intelligence-motion.mjs",
    "test:browser:workflows": "node scripts/browser-workflows.mjs",
    "responsibilities:run": "node --env-file-if-exists=.env.local --import=tsx scripts/responsibilities.ts",
    "test:agent-workspace": "node scripts/agent-workspace-smoke.mjs",
    "test:agent-followup": "node scripts/agent-workspace-smoke.mjs --followup",
    "test:agent-runner": "node scripts/agent-workspace-smoke.mjs --runner",
    "test:personal-agent": "node scripts/personal-agent-smoke.mjs",
    "platform:worker": "node --import=tsx scripts/platform-worker.ts",
    "identity:invite": "node --import=tsx scripts/invite-user.ts",
    "contracts:generate": "node scripts/generate-openapi.mjs && openapi-typescript packages/contracts/openapi.json -o packages/api-client/src/generated.ts",
    "test:platform": "node scripts/run-platform-tests.mjs",
    "test:platform:http": "node scripts/platform-http-smoke.mjs",
    "mobile:typecheck": "npm run typecheck --workspace @agus/mobile",
    "mobile:export:android": "npm run export:android --workspace @agus/mobile",
    "p2p:fixture-trader": "node --import=tsx scripts/fixture-trader.ts",
    "p2p:fixture-authorities": "node --import=tsx scripts/fixture-escrow-authorities.ts",
    "mobile:build:storage": "node scripts/android-build-preflight.mjs",
    "mobile:build:preflight": "node scripts/android-build-preflight.mjs --check",
    "test:escrow": "cargo test --manifest-path escrow/Cargo.toml --locked --features bank-tests",
    "test:marketplace": "node scripts/run-marketplace-tests.mjs",
    "build:escrow:sbf": "node scripts/build-escrow-sbf.mjs",
    "test:escrow:sbf": "node scripts/test-escrow-sbf.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.19",
    "@electric-sql/pglite": "^0.3.10",
    "@google/genai": "2.30.0",
    "@pollar/core": "^0.12.0",
    "@scure/base": "^1.2.6",
    "@solana/web3.js": "^1.99.0",
    "@stellar/stellar-base": "^15.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "better-auth": "1.7.19",
    "decimal.js": "10.6.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.4.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@solana/spl-token": "^0.4.15",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "overrides": {
    "jayson": "5.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
